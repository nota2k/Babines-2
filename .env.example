# URL du CouchDB hébergé (vide = fonctionnement 100 % local, sans synchronisation)
VITE_COUCHDB_URL=
# Nom de la base. Ne pas coder en dur ailleurs : c'est ce qui garde ouverte
# la porte du multi-utilisateur (décision 4 de la spec).
VITE_COUCHDB_DB=babines
# Base des webhooks n8n
VITE_N8N_BASE_URL=https://tentacules.pantagruweb.club/webhook
